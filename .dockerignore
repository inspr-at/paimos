# Keep repository source (including docs) available to the SPA build.
# Patterns start at the context root; ** also covers nested copies.
**/node_modules
**/dist
**/.git

# Local environment and credential files must never enter a build stage.
**/.env
**/.env.*
**/*.env
**/secrets
**/.local
**/.aws
**/.ssh
**/.npmrc
**/*.secret
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/*_token
**/*_credentials*
**/credentials.json
**/service-account*.json

# Generated test output, build caches, and developer tooling.
**/coverage
**/.nyc_output
**/test-results
**/playwright-report
**/blob-report
**/.cache
**/.npm
**/.vite
**/*.tsbuildinfo
**/__pycache__
**/*.pyc
**/*.log
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo
**/*~
.devenv
.direnv
.docker
.claude/worktrees
.paimos/cache
.playwright-mcp
scripts/.visual-tooling
.dev-up-backend
.dev-up-logs
backend/paimos
backend/tmp
backend/data
data/*.db*
data/*.sqlite*
data/avatars
docs/RUNBOOK.md
