    "ExternalStageReporterRegistrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_key_id",
        "reporter_class",
        "reporter_role"
      ],
      "properties": {
        "api_key_id": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "reporter_class": {
          "type": "string",
          "enum": [
            "pharos",
            "janus"
          ]
        },
        "reporter_role": {
          "type": "string",
          "enum": [
            "owner",
            "dependency"
          ]
        },
        "dependency_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "workflow": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "reporter_class": {
              "const": "pharos"
            },
            "reporter_role": {
              "const": "owner"
            }
          },
          "required": [
            "workflow",
            "environment"
          ],
          "not": {
            "required": [
              "dependency_key"
            ]
          }
        },
        {
          "properties": {
            "reporter_class": {
              "const": "janus"
            },
            "reporter_role": {
              "const": "dependency"
            }
          },
          "required": [
            "dependency_key"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "workflow"
                ]
              },
              {
                "required": [
                  "environment"
                ]
              }
            ]
          }
        }
      ]
    },
