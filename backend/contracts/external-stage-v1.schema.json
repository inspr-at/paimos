    "ExternalStagePharosEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workflow",
        "environment",
        "artifact",
        "result",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "deployment",
            "verification"
