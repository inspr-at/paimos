          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Symbolic allowlisted workflow/environment and exact artifact identity only; no command, path, callback, or URL fields exist."
    },
    "ExternalStageJanusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "result",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "authorization",
            "credential_handoff"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "satisfied",
            "blocked"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "credential_ready": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "authorization"
            },
            "result": {
              "const": "satisfied"
            },
            "authorized": {
              "const": true
            }
          },
          "required": [
            "authorized"
          ],
          "not": {
            "required": [
              "credential_ready"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "authorization"
            },
            "result": {
              "const": "blocked"
            },
            "authorized": {
              "const": false
            }
          },
          "required": [
            "authorized"
          ],
          "not": {
            "required": [
              "credential_ready"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "credential_handoff"
            },
            "result": {
              "const": "satisfied"
            },
            "credential_ready": {
              "const": true
            }
          },
          "required": [
            "credential_ready"
          ],
          "not": {
            "required": [
              "authorized"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "credential_handoff"
            },
            "result": {
              "const": "blocked"
            },
            "credential_ready": {
              "const": false
            }
          },
          "required": [
            "credential_ready"
          ],
          "not": {
            "required": [
              "authorized"
            ]
          }
        }
      ],
      "description": "Value-free enum, boolean, and timestamp facts only; no free text, opaque ID, path, URL, digest, version, ciphertext, command, callback, or secret field exists."
    },
    "ExternalStageReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "state",
        "observed_at",
        "heartbeat"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 2
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "waiting",
            "blocked",
            "succeeded",
            "failed"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeat": {
          "type": "boolean"
        },
        "blocker_codes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "dependency_pending",
              "dependency_failed",
              "reporter_stale",
              "external_waiting"
            ]
          }
        },
        "pharos_evidence": {
          "$ref": "#/$defs/ExternalStagePharosEvidence"
        },
        "janus_evidence": {
          "$ref": "#/$defs/ExternalStageJanusEvidence"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "pharos_evidence",
              "janus_evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "heartbeat": {
                "const": true
              }
            },
            "required": [
              "heartbeat"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "waiting",
                  "blocked"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "blocker_codes"
                  ]
                },
                {
                  "required": [
                    "pharos_evidence"
                  ]
                },
                {
                  "required": [
                    "janus_evidence"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "heartbeat": {
                "const": false
              },
              "state": {
                "const": "blocked"
              }
            },
            "required": [
              "heartbeat",
              "state"
            ]
          },
          "then": {
            "required": [
              "blocker_codes"
            ],
            "properties": {
              "blocker_codes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "heartbeat": {
                "const": false
              },
              "state": {
                "enum": [
                  "active",
                  "waiting",
                  "succeeded",
                  "failed"
                ]
              }
            },
            "required": [
              "heartbeat",
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "blocker_codes"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "succeeded",
                  "failed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "pharos_evidence"
                ]
              },
              {
                "required": [
                  "janus_evidence"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "active",
                  "waiting"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "pharos_evidence"
                  ]
                },
                {
                  "required": [
                    "janus_evidence"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "pharos_evidence"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "const": "succeeded"
                  },
                  "pharos_evidence": {
                    "properties": {
                      "result": {
                        "const": "succeeded"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "failed"
                  },
                  "pharos_evidence": {
                    "properties": {
                      "result": {
                        "const": "failed"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "janus_evidence"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "state": {
                    "const": "succeeded"
                  },
                  "janus_evidence": {
                    "properties": {
                      "result": {
                        "const": "satisfied"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "state": {
                    "const": "blocked"
                  },
                  "janus_evidence": {
                    "properties": {
                      "result": {
                        "const": "blocked"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "description": "The registered reporter class and server-owned ceiling select the permitted evidence variant; body fields never grant class or role."
    },
    "ExternalStageReportReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "sequence",
        "state",
        "credential_epoch",
        "duplicate",
        "server_received_at"
      ],
      "properties": {
        "handoff_id": {
          "$ref": "#/$defs/ExternalStageHandoffID"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/ExternalStageHandoffState"
        },
        "credential_epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "duplicate": {
          "type": "boolean"
        },
        "server_received_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ExternalStageHandoffID": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Server-generated non-sequential opaque public locator, distinct from the handoff secret."
    },
    "ExternalStageSHA256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ExternalStageHandoffState": {
      "type": "string",
      "enum": [
        "issued",
        "accepted",
        "active",
        "waiting",
        "blocked",
        "succeeded",
        "failed"
      ]
    }
  }
}
