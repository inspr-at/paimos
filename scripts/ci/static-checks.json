      "id": "volatile-identity",
      "command": "python3 - <<'PY'\nimport pathlib, re, sys\n# Include multiline calls and indirect reads via named constants.\nvolatile = re.compile(r'\\bGITHUB_(?:SHA|RUN_ID|RUN_NUMBER|RUN_ATTEMPT)\\b')\nallowed = '--source-digest \\\\\"$GITHUB_SHA\\\\\"'\nfailures = []\nfor path in sorted(pathlib.Path('.').rglob('*_test.go')):\n    source = path.read_text()\n    # This existing release-contract assertion checks a workflow's\n    # literal binding; it does not read the process environment.\n    if path.as_posix() == 'scripts/releaseworkflow/workflow_test.go':\n        source = source.replace(allowed, '')\n    for match in volatile.finditer(source):\n        line = source.count('\\n', 0, match.start()) + 1\n        failures.append(f'{path}:{line}: volatile CI identity in test source')\nif failures:\n    print('\\n'.join(failures), file=sys.stderr)\n    sys.exit(1)\nprint('Go tests do not depend on volatile CI identity')\nPY",
      "cwd": ".",
      "ci": {
        "job": "go-static",
