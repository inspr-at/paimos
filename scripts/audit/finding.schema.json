{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeon:audit:slice:v1",
  "title": "Aeon audit slice manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice",
    "sha",
    "coverage",
    "findings",
    "good"
  ],
  "properties": {
    "slice": {
      "type": "string",
      "pattern": "^(S[1-9][0-9]*|T)$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{12,40}$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "lines",
          "status"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "read",
              "generated",
              "vendored",
              "not-code"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "good": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "severity",
        "confidence",
        "locations",
        "evidence",
        "why_it_matters",
        "fix",
        "effort",
        "related_tickets",
        "theme"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "security",
            "architecture",
            "correctness",
            "concurrency",
            "error-handling",
            "performance",
            "maintainability",
            "testing",
            "api-contract",
            "dependency",
            "observability",
            "accessibility",
            "ux-consistency"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effort": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "related_tickets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
          }
        },
        "tool": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
