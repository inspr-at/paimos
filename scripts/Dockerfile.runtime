# SPDX-License-Identifier: AGPL-3.0-only
# Official Alpine 3.24.2 multi-platform index, observed on Docker Hub 2026-10-05:
# https://hub.docker.com/layers/library/alpine/3.24/images/sha256-d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395
# Keep both native architectures. Never resolve a floating base at assembly.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
# Cache this closure independently of source/version. Export with epoch 0 and
# rewrite-timestamp=true; its OCI digest freezes all transitive APK bytes too.
# APK repositories remain mutable during preparation, not during assembly.
RUN apk add --no-cache ca-certificates chromium=152.0.7977.82-r0 tini=0.19.0-r3 \
    && addgroup -S -g 65532 aeon && adduser -S -D -u 65532 -G aeon aeon
